# ── LTA DataMall ─────────────────────────────────────────────
# Free API key from https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
# Used by src/data/ltaClient.js to fetch real bicycle rack locations.
VITE_LTA_KEY=your-lta-account-key-here

# ── Routing API (used in Ship 2, optional for now) ───────────
# Free 2000 req/day from https://openrouteservice.org/dev/#/signup
VITE_ORS_KEY=your-openrouteservice-key-here
